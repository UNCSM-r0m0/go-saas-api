# GEMINI_API_KEY=your-gemini-key

# DeepSeek (opcional)
# DEEPSEEK_API_KEY=your-deepseek-key

# LM Studio (opcional - servidor local de modelos)
# LM_STUDIO_URL=http://192.168.1.13:1234
# LM_STUDIO_API_KEY=sk-lm-your-key

# Proxy de Ollama (opcional - para usar IA en la nube como respaldo)
