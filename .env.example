# ==========================================
# AI PROVIDERS
# ==========================================

# Ollama (local)
OLLAMA_URL=http://host.docker.internal:11434

# OpenAI (opcional - se usa si OPENAI_API_KEY estÃƒÂ¡ configurada)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

