# ==========================================
# CONFIGURACION GENERAL
# ==========================================

ENV=development
LOG_LEVEL=info

# URLs publicas
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# JWT Secret (cambiar por uno seguro en produccion)
JWT_SECRET=tu_secreto_jwt_muy_seguro_32_caracteres_minimo
JWT_EXPIRATION=7d

# ==========================================
# BASE DE DATOS
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saas_db?sslmode=disable

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_seguro
POSTGRES_DB=saas_db

# ==========================================
# REDIS & NATS
# ==========================================

REDIS_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222

# ==========================================
# AI PROVIDERS
# ==========================================

# Ollama (local)
OLLAMA_URL=http://host.docker.internal:11434

# OpenAI (opcional)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (opcional)
# GEMINI_API_KEY=your-gemini-key

# DeepSeek (opcional)
# DEEPSEEK_API_KEY=your-deepseek-key

# Kimi / Moonshot AI (opcional)
# KIMI_API_KEY=sk-tu-kimi-key

# LM Studio (opcional)
# LM_STUDIO_URL=http://192.168.1.13:1234
# LM_STUDIO_API_KEY=sk-lm-your-key

# Proxy de Ollama (opcional)
# OLLAMA_PROXY_URL=https://tu-proxy-ia.com
# OLLAMA_PROXY_API_KEY=tu_api_key

# ==========================================
# OAUTH - GOOGLE
# ==========================================

GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ==========================================
# OAUTH - GITHUB
# ==========================================

GITHUB_CLIENT_ID=tu_github_client_id
GITHUB_CLIENT_SECRET=tu_github_client_secret

# ==========================================
# STRIPE (PAGOS)
# ==========================================

STRIPE_SECRET_KEY=sk_test_tu_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
STRIPE_PREMIUM_PRICE_ID=price_tu_price_id

# ==========================================
# SMTP / EMAIL
# ==========================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=tu_password_smtp
SMTP_FROM=noreply@example.com

# ==========================================
# LIMITES DE USO (mensajes por mes)
# ==========================================

# Para desarrollo local, start-local.ps1 sobrescribe estos valores a 1000/5000.
FREE_USER_MESSAGE_LIMIT=5
REGISTERED_USER_MESSAGE_LIMIT=50
PREMIUM_USER_MESSAGE_LIMIT=500

REGISTERED_USER_MAX_TOKENS=2048
PREMIUM_USER_MAX_TOKENS=8192

# ==========================================
# SERVICIOS INTERNOS
# ==========================================

AGENT_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001
BILLING_SERVICE_URL=http://localhost:3003
USAGE_SERVICE_URL=http://localhost:3004
SANDBOX_SERVICE_URL=http://localhost:3005
DOCUMENT_SERVICE_URL=http://localhost:8000

# ==========================================
# SANDBOX & NATS EVENTS
# ==========================================

SANDBOX_RATE_LIMIT=5
NATS_EVENTS_ENABLED=true
