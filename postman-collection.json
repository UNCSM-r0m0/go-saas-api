						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ollama Local\",\n  \"type\": \"ollama\",\n  \"base_url\": \"http://localhost:11434\",\n  \"priority\": 1,\n  \"is_public\": true\n}"
						},
						"url": { "raw": "{{base_url}}/admin/providers", "host": ["{{base_url}}"], "path": ["admin", "providers"] }
