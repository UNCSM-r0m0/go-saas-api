						"body": { "mode": "raw", "raw": "{\n  \"price_id\": \"{{stripe_price_id}}\"\n}" },
						"url": { "raw": "{{base_url}}/api/v1/billing/checkout", "host": ["{{base_url}}"], "path": ["api", "v1", "billing", "checkout"] }
					}
				},
