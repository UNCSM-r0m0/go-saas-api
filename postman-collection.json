						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/admin/providers/{{provider_id}}", "host": ["{{base_url}}"], "path": ["admin", "providers", "{{provider_id}}"] }
