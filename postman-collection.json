			"request": {
				"method": "POST",
				"header": [
					{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
				],
				"url": {
					"raw": "http://localhost:3000/api/v1/auth/logout",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
