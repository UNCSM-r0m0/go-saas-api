				"body": {
					"mode": "raw",
					"raw": "{\n  \"message\": \"Hola, ¿qué modelo eres?\",\n  \"model\": \"kimi-for-coding\"\n}"
				},
				"url": {
					"raw": "http://localhost:3002/agent/chat",
					"protocol": "http",
					"host": ["localhost"],
