				"method": "POST",
				"header": [
					{"key": "Content-Type", "value": "application/json"},
					{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"message\": \"Hola, ¿qué modelo eres?\",\n  \"model\": \"kimi-k2.6\"\n}"
				},
				"url": {
					"raw": "http://localhost:3002/agent/chat",
					"protocol": "http",
