						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/conversations/{{conv_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "conversations", "{{conv_id}}"] }
					}
				},
				{
					"name": "Get Messages",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/conversations/{{conv_id}}/messages", "host": ["{{base_url}}"], "path": ["api", "v1", "conversations", "{{conv_id}}", "messages"] }
					}
				}
			]
		},
		{
			"name": "Files & Documents",
			"item": [
				{
					"name": "Upload File",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] },
						"url": { "raw": "{{base_url}}/api/v1/files/upload", "host": ["{{base_url}}"], "path": ["api", "v1", "files", "upload"] }
					}
				},
				{
					"name": "Get Document",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/documents/{{doc_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "documents", "{{doc_id}}"] }
					}
				}
			]
		},
		{
			"name": "Sandbox",
			"item": [
				{
					"name": "Execute Code",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"language\": \"python\",\n  \"code\": \"print('hello world')\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/sandbox/execute", "host": ["{{base_url}}"], "path": ["api", "v1", "sandbox", "execute"] }
					}
				}
			]
		},
		{
			"name": "Billing",
			"item": [
				{
					"name": "Get Subscription",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/subscriptions", "host": ["{{base_url}}"], "path": ["api", "v1", "subscriptions"] }
					}
