{
	"info": {
		"_postman_id": "go-saas-api-local-v2",
		"name": "go-saas-api",
		"description": "Collection for go-saas-api — all endpoints via API Gateway (:3000). Uses {{base_url}} and {{jwt_token}} variables.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000" },
		{ "key": "jwt_token", "value": "" },
		{ "key": "api_key", "value": "" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123456!\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": { "exec": ["const res = pm.response.json();", "if (res.access_token) pm.collectionVariables.set('jwt_token', res.access_token);"], "type": "text/javascript" }
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Test123456!\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
						"url": { "raw": "{{base_url}}/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "refresh"] }
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/auth/profile", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "profile"] }
					}
				}
			]
		},
		{
			"name": "Chat (Authenticated)",
			"item": [
				{
					"name": "List Models",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/chat/models", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "models"] }
					}
				},
				{
					"name": "List Public Models",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/models/public", "host": ["{{base_url}}"], "path": ["api", "v1", "models", "public"] }
					}
				},
				{
					"name": "Create Chat Session",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"New conversation\",\n  \"model\": \"glm-5.1\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/chat", "host": ["{{base_url}}"], "path": ["api", "v1", "chat"] }
					}
				},
				{
					"name": "List Chat Sessions",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/chat/sessions", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "sessions"] }
					}
				},
				{
					"name": "Get Chat with Messages",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/chat/{{chat_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "{{chat_id}}"] }
					}
				},
				{
					"name": "Send Message (non-stream)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Hello, what model are you?\",\n  \"model\": \"glm-5.1\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/chat/message", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "message"] }
					}
				},
				{
					"name": "Send Message (SSE stream)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "text/event-stream" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Hello, what model are you?\",\n  \"model\": \"glm-5.1\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/chat/message/stream", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "message", "stream"] }
					}
				},
				{
					"name": "Agent Chat (legacy SSE)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Accept", "value": "text/event-stream" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message\": \"Hello, what model are you?\",\n  \"model\": \"glm-5.1\"\n}"
						},
						"url": { "raw": "{{base_url}}/api/v1/agent/chat", "host": ["{{base_url}}"], "path": ["api", "v1", "agent", "chat"] }
					}
				},
				{
					"name": "Update Chat Session",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated title\"\n}" },
						"url": { "raw": "{{base_url}}/api/v1/chat/sessions/{{chat_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "sessions", "{{chat_id}}"] }
					}
				},
				{
					"name": "Delete Chat Session",
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/chat/sessions/{{chat_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "chat", "sessions", "{{chat_id}}"] }
					}
				}
			]
		},
		{
			"name": "Conversations (Legacy)",
			"item": [
				{
					"name": "List Conversations",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
						"url": { "raw": "{{base_url}}/api/v1/conversations", "host": ["{{base_url}}"], "path": ["api", "v1", "conversations"] }
